{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "channel": "chrome",
      "headless": true
    },
    "contextOptions": {
      "viewport": {
        "width": 1440,
        "height": 1024
      },
      "locale": "fr-FR",
      "timezoneId": "Africa/Douala"
    }
  },
  "outputDir": "output/playwright",
  "outputMode": "file"
}
